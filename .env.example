# Supabase (safe for the browser — publishable key only, never the service role key)
VITE_SUPABASE_URL=https://wtplnrricyaevlsnsuth.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=

# Browser Push (optional, not yet configured — see PWA & Push implementation
# report). The VAPID public key is safe for the browser; its private
# counterpart must live only as a Supabase Edge Function secret, never here.
VITE_VAPID_PUBLIC_KEY=

# Supabase Edge Function Secrets for send-push-notification (set in Supabase Dashboard or CLI):
# VAPID_PUBLIC_KEY=<same base64url value as VITE_VAPID_PUBLIC_KEY>
# VAPID_PRIVATE_KEY=<base64url private key>
# VAPID_SUBJECT=mailto:support@eci.com

